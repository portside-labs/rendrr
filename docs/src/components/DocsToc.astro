---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  items.length > 0 && (
    <aside class="docs-toc" data-toc>
      <h5 class="docs-toc__title">On this page</h5>
      <nav class="docs-toc__nav">
        {items.map((h) => (
          <a
            href={`#${h.slug}`}
            class:list={["docs-toc__link", `depth-${h.depth}`]}
            data-toc-link={h.slug}
          >
            {h.text}
          </a>
        ))}
      </nav>
    </aside>
  )
}

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");
  const targets = Array.from(links)
    .map((l) => document.getElementById(l.dataset.tocLink!))
    .filter((el): el is HTMLElement => !!el);

  if (targets.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        if (visible.length === 0) return;
        const top = visible.reduce((a, b) =>
          a.boundingClientRect.top < b.boundingClientRect.top ? a : b
        );
        links.forEach((l) => l.classList.toggle("is-active", l.dataset.tocLink === top.target.id));
      },
      { rootMargin: "-80px 0px -70% 0px", threshold: 0 }
    );
    targets.forEach((t) => observer.observe(t));
  }
</script>

<style>
  .docs-toc {
    position: sticky;
    top: 84px;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
    padding-left: var(--space-4);
    border-left: 1px solid var(--border-color);
  }

  .docs-toc__title {
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    margin-bottom: var(--space-4);
  }

  .docs-toc__nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .docs-toc__link {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    text-decoration: none;
    padding: 6px var(--space-3);
    border-radius: var(--radius-sm);
    transition: color var(--duration-fast) var(--ease-out);
    line-height: 1.4;
  }

  .docs-toc__link:hover { color: var(--ink); }

  .docs-toc__link.is-active {
    color: var(--accent);
    font-weight: 600;
  }

  .docs-toc__link.depth-3 {
    padding-left: var(--space-6);
    font-size: 0.8125rem;
  }

  @media (max-width: 1024px) {
    .docs-toc { display: none; }
  }
</style>
