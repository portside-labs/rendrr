---
import { DOCS, API_REFERENCE } from "~/data/nav";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentPath = new URL(Astro.request.url).pathname.replace(/\/$/, "");

function href(slug: string) {
  return slug ? `${base}/${slug}` : `${base}/`;
}

function isActive(slug: string) {
  const target = (slug ? `${base}/${slug}` : `${base}`).replace(/\/$/, "");
  return currentPath === target || currentPath === `${target}/`;
}
---

<aside class="docs-sidebar">
  <h5 class="docs-sidebar__title">Docs</h5>
  <nav class="docs-sidebar__nav">
    {
      DOCS.map((d) => (
        <a
          href={href(d.slug)}
          class:list={["docs-sidebar__link", { "is-active": isActive(d.slug) }]}
        >
          {d.title}
        </a>
      ))
    }
    <a
      href={href(API_REFERENCE.slug)}
      class:list={["docs-sidebar__link", { "is-active": isActive(API_REFERENCE.slug) }]}
    >
      {API_REFERENCE.title}
    </a>
  </nav>
</aside>

<style>
  .docs-sidebar {
    position: sticky;
    top: 84px;
  }

  .docs-sidebar__title {
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    margin-bottom: var(--space-4);
  }

  .docs-sidebar__nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .docs-sidebar__link {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink-muted);
    text-decoration: none;
    padding: 8px var(--space-3);
    border-radius: var(--radius-md);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .docs-sidebar__link:hover {
    color: var(--ink);
    background: var(--paper-warm);
  }

  .docs-sidebar__link.is-active {
    color: var(--accent);
    background: var(--accent-light);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .docs-sidebar {
      position: static;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: var(--space-4);
    }
    .docs-sidebar__nav {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-1);
    }
  }
</style>
