# =============================================================================
# Rendrr — example environment configuration
# Copy to `.env` and edit the values you need.
# =============================================================================

# -- Server -------------------------------------------------------------------
PORT=3000

# Log verbosity. Accepted values: trace, debug, info (default), warn, error.
# LOG_LEVEL=info

# Set to "true" to include internal error details in API responses (dev only)
# DEBUG_ERRORS=true

# Comma-separated list of origins allowed to call the API from a browser.
# Unset (or "*") allows any origin, which is fine behind an authenticating
# proxy on a trusted network but too permissive for a public deployment.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# -- Optional TLS (HTTPS) -----------------------------------------------------
# Set both to enable TLS. Files must be PEM-encoded.
# TLS_CERT_PATH=/etc/rendrr/tls/fullchain.pem
# TLS_KEY_PATH=/etc/rendrr/tls/privkey.pem

# -- Optional OAuth 2.0 / OIDC bearer-token validation ------------------------
# Leave OAUTH_ISSUER unset to run with no authentication (open service).
# When OAUTH_ISSUER is set, every request must present a valid `Authorization:
# Bearer <jwt>` header signed by the issuer and matching the audience, AND
# carry the scope required by the endpoint being called. Issue tokens with
# the scopes a given client should have access to.
# OAUTH_ISSUER=https://auth.example.com/
# OAUTH_AUDIENCE=rendrr-api
# OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json   # optional, defaults to OIDC discovery
# OAUTH_ALLOWED_CLIENT_IDS=client-a,client-b                       # optional allowlist (azp / client_id claim)
#
# Rendrr's scope names are always prefixed `rendrr<sep>...` to avoid colliding
# with existing scopes in your IdP. Pick a separator that matches your IdP's
# convention. Allowed values: ":" (default, GitHub-style), "." (Google-style),
# "/" (URL-path-style).
# RENDRR_SCOPE_SEPARATOR=:
#
# Resulting scope names with each separator:
#   :   rendrr:templates:write   rendrr:templates:delete   rendrr:renders:write   rendrr:renders:read
#   .   rendrr.templates.write   rendrr.templates.delete   rendrr.renders.write   rendrr.renders.read
#   /   rendrr/templates/write   rendrr/templates/delete   rendrr/renders/write   rendrr/renders/read

# -- Image fetching -----------------------------------------------------------
# The {{image}} helper fetches URLs supplied in render data, so by default
# Rendrr refuses to connect to anything that resolves to a non-public address
# (loopback, RFC1918, link-local — which is where cloud metadata endpoints
# live). Set this to "true" only if you serve template images from a host
# inside your own private network, and only when you trust every client that
# can submit a render.
# IMAGE_FETCH_ALLOW_PRIVATE_NETWORKS=false

# -- Template storage (any S3-compatible bucket) ------------------------------
TEMPLATE_BUCKET_NAME=rendrr-templates
TEMPLATE_BUCKET_ENDPOINT=http://localhost:9002   # comment out for AWS S3
TEMPLATE_BUCKET_ACCESS_KEY_ID=minioadmin
TEMPLATE_BUCKET_SECRET_ACCESS_KEY=minioadmin
TEMPLATE_BUCKET_REGION=us-east-1

# -- Render storage -----------------------------------------------------------
RENDER_BUCKET_NAME=rendrr-renders
RENDER_BUCKET_ENDPOINT=http://localhost:9002     # comment out for AWS S3
RENDER_BUCKET_ACCESS_KEY_ID=minioadmin
RENDER_BUCKET_SECRET_ACCESS_KEY=minioadmin
RENDER_BUCKET_REGION=us-east-1

# =============================================================================
# Notes
# =============================================================================
# * For production AWS S3, drop the *_BUCKET_ENDPOINT lines and set the region
#   to your bucket's region. IAM roles are preferred over static credentials.
# * Templates and renders may share a bucket; set TEMPLATE_BUCKET_NAME and
#   RENDER_BUCKET_NAME to the same value.
# * Local dev: `docker compose up -d` to bring up MinIO, then `cargo run`.
